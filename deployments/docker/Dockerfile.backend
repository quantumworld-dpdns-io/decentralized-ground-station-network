ARG GO_VERSION=1.22.0
ARG ALPINE_VERSION=3.20
ARG DISTROLESS_VERSION=nonroot

FROM golang:${GO_VERSION}-alpine${ALPINE_VERSION} AS builder

RUN apk add --no-cache git ca-certificates build-base protobuf protobuf-dev

WORKDIR /workspace

COPY go.mod go.sum ./
RUN go mod download

COPY api/ api/
COPY cmd/ cmd/
COPY internal/ internal/
COPY pkg/ pkg/

RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
    -trimpath \
    -ldflags="-s -w -X main.version=0.1.0 -X main.commit=$(git rev-parse --short HEAD 2>/dev/null || echo 'unknown')" \
    -o /usr/local/bin/dgsn-server \
    ./cmd/dgsn-server/

FROM gcr.io/distroless/static:${DISTROLESS_VERSION}

COPY --from=builder /usr/local/bin/dgsn-server /usr/local/bin/dgsn-server

COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/

USER 65532:65532

EXPOSE 9090
EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/dgsn-server"]
CMD ["--config", "/etc/dgsn/config.yaml"]
