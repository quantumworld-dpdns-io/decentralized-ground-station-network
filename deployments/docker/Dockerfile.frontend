ARG NODE_VERSION=22-alpine
ARG NGINX_VERSION=1.26-alpine

FROM node:${NODE_VERSION} AS builder

RUN apk add --no-cache git python3 make g++

WORKDIR /workspace

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL:-http://localhost:8080}

ARG NEXT_PUBLIC_WS_URL
ENV NEXT_PUBLIC_WS_URL=${NEXT_PUBLIC_WS_URL:-ws://localhost:8080}

RUN npm run build

FROM nginx:${NGINX_VERSION}

RUN rm -rf /usr/share/nginx/html/*

COPY --from=builder /workspace/out/ /usr/share/nginx/html/
COPY deployments/docker/nginx.conf /etc/nginx/conf.d/default.conf

RUN chown -R nginx:nginx /usr/share/nginx/html

USER nginx

EXPOSE 80
EXPOSE 443

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -qO- http://localhost/health || exit 1

CMD ["nginx", "-g", "daemon off;"]
