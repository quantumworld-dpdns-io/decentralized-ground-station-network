{
  "title": "DGSN - Security Events",
  "version": 2,
  "uid": "dgsn-security",
  "description": "Security event monitoring, audit logs, PQC key rotation status, and compliance tracking",
  "tags": ["dgsn", "security", "compliance"],
  "timezone": "utc",
  "editable": false,
  "refresh": "30s",
  "panels": [
    {
      "title": "Security Events by Severity",
      "type": "piechart",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
      "targets": [
        {"expr": "sum by(severity) (increase(dgsn_security_alerts_total[24h]))"}
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"}
        }
      },
      "datasource": {"type": "prometheus", "uid": "prometheus"}
    },
    {
      "title": "Events Over Time",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 16, "x": 8, "y": 0},
      "targets": [
        {"expr": "rate(dgsn_security_alerts_total[5m])", "legendFormat": "{{severity}}"},
        {"expr": "rate(dgsn_tetragon_signal_violations_total[5m])", "legendFormat": "Tetragon violations"},
        {"expr": "rate(dgsn_auth_failures_total[5m])", "legendFormat": "Auth failures"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {"mode": "palette-classic"},
          "custom": {"showPoints": "never"}
        }
      },
      "datasource": {"type": "prometheus", "uid": "prometheus"}
    },
    {
      "title": "Top Sources",
      "type": "table",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8},
      "targets": [
        {"expr": "topk(10, sum by(source_ip) (increase(dgsn_security_alerts_total[24h])))", "legendFormat": "{{source_ip}}"}
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "custom": {"align": "auto"}
        }
      },
      "datasource": {"type": "prometheus", "uid": "prometheus"}
    },
    {
      "title": "Audit Log Count",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 8},
      "targets": [
        {"expr": "sum(increase(dgsn_audit_log_entries_total[24h]))", "legendFormat": "24h count"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": 0}, {"color": "red", "value": 10000}]}
        }
      },
      "datasource": {"type": "prometheus", "uid": "prometheus"}
    },
    {
      "title": "Failed Auth Attempts",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {"expr": "rate(dgsn_auth_failures_total[5m])", "legendFormat": "All failures"},
        {"expr": "rate(dgsn_auth_failures_total{reason=\"invalid_token\"}[5m])", "legendFormat": "Invalid token"},
        {"expr": "rate(dgsn_auth_failures_total{reason=\"expired\"}[5m])", "legendFormat": "Expired"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {"mode": "palette-classic"},
          "custom": {"showPoints": "never"}
        }
      },
      "datasource": {"type": "prometheus", "uid": "prometheus"}
    },
    {
      "title": "PQC Key Rotation Status",
      "type": "state-timeline",
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 16},
      "targets": [
        {"expr": "dgsn_pqc_key_rotation_status", "legendFormat": "{{algorithm}}"}
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": 0}, {"color": "yellow", "value": 1}, {"color": "green", "value": 2}]}
        }
      },
      "datasource": {"type": "prometheus", "uid": "prometheus"}
    },
    {
      "title": "OWASP Scan Results",
      "type": "table",
      "gridPos": {"h": 8, "w": 12, "x": 8, "y": 16},
      "targets": [
        {"expr": "dgsn_owasp_scan_findings", "legendFormat": ""}
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 1}, {"color": "red", "value": 2}]},
          "custom": {"align": "auto"}
        }
      },
      "datasource": {"type": "prometheus", "uid": "prometheus"}
    },
    {
      "title": "Vulnerability Age",
      "type": "histogram",
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 22},
      "targets": [
        {"expr": "dgsn_vulnerability_age_days"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "days",
          "color": {"mode": "scheme", "scheme": "reds"},
          "custom": {"hideFrom": {"legend": false}}
        }
      },
      "datasource": {"type": "prometheus", "uid": "prometheus"}
    },
    {
      "title": "Compliance Status",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 20, "y": 22},
      "targets": [
        {"expr": "dgsn_compliance_status", "legendFormat": "Status"}
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": 0}, {"color": "yellow", "value": 1}, {"color": "green", "value": 2}]}
        }
      },
      "datasource": {"type": "prometheus", "uid": "prometheus"}
    },
    {
      "title": "Active Alerts",
      "type": "table",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
      "targets": [
        {"expr": "ALERTS{alertstate=\"firing\"}", "legendFormat": "{{alertname}}"}
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": 0}]},
          "custom": {"align": "auto"}
        }
      },
      "datasource": {"type": "prometheus", "uid": "prometheus"}
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus"
      }
    ]
  }
}
