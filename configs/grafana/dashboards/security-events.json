{
  "title": "DGSN Security Events",
  "version": 1,
  "uid": "dgsn-security",
  "description": "Security event monitoring, audit logs, and compliance tracking",
  "tags": ["dgsn", "security", "compliance"],
  "timezone": "utc",
  "editable": false,
  "panels": [
    {
      "title": "Active Security Alerts",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
      "targets": [{"expr": "count(dgsn_security_alerts{severity=\"critical\"})"}],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": 0}, {"color": "red", "value": 1}]}
        }
      }
    },
    {
      "title": "Signal Processing Violations (24h)",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 0},
      "targets": [{"expr": "sum(increase(dgsn_tetragon_signal_violations_total[24h]))"}],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 1}, {"color": "red", "value": 10}]}
        }
      }
    },
    {
      "title": "Auth Failures (1h)",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 0},
      "targets": [{"expr": "sum(increase(dgsn_auth_failures_total[1h]))"}],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 5}, {"color": "red", "value": 20}]}
        }
      }
    },
    {
      "title": "ZKP Verification Failures (24h)",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 0},
      "targets": [{"expr": "sum(increase(dgsn_zkp_verification_failures_total[24h]))"}],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 1}, {"color": "red", "value": 5}]}
        }
      }
    },
    {
      "title": "TLS Certificate Expiry",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 16, "y": 0},
      "targets": [{"expr": "dgsn_tls_cert_expiry_days"}],
      "fieldConfig": {
        "defaults": {
          "unit": "days",
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": 0}, {"color": "yellow", "value": 14}, {"color": "green", "value": 30}]}
        }
      }
    },
    {
      "title": "Unauthorized Access Attempts (24h)",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 20, "y": 0},
      "targets": [{"expr": "sum(increase(dgsn_unauthorized_access_total[24h]))"}],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 1}, {"color": "red", "value": 10}]}
        }
      }
    },
    {
      "title": "Security Events Timeline",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 4},
      "targets": [
        {"expr": "rate(dgsn_security_alerts_total[5m])", "legendFormat": "{{severity}}"},
        {"expr": "rate(dgsn_tetragon_signal_violations_total[5m])", "legendFormat": "Tetragon violations"},
        {"expr": "rate(dgsn_auth_failures_total[5m])", "legendFormat": "Auth failures"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {"mode": "palette-classic"},
          "custom": {"showPoints": "never"}
        }
      }
    },
    {
      "title": "eBPF Monitored Processes",
      "type": "table",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "targets": [
        {"expr": "dgsn_tetragon_monitored_processes", "legendFormat": ""}
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "custom": {"align": "auto"}
        }
      }
    },
    {
      "title": "Recent Audit Log Events",
      "type": "logs",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "targets": [
        {"expr": "{service=~\"dgsn-backend|dgsn-crypto-kernel\"} |= \"audit\"", "legendFormat": ""}
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {"showPoints": "never"}
        }
      }
    },
    {
      "title": "Security Alert Severity Distribution",
      "type": "piechart",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 20},
      "targets": [
        {"expr": "sum by(severity) (increase(dgsn_security_alerts_total[24h]))"}
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"}
        }
      }
    },
    {
      "title": "PQC Algorithm Usage",
      "type": "piechart",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 20},
      "targets": [
        {"expr": "sum by(algorithm) (rate(dgsn_crypto_operations_total[24h]))"}
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"}
        }
      }
    },
    {
      "title": "Compliance: SOC 2 Controls",
      "type": "table",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 20},
      "targets": [
        {"expr": "dgsn_compliance_soc2_status"}
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "custom": {"align": "auto"}
        }
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus"
      }
    ]
  }
}
